<odoo>
    <record id="view_partner_form_inherit_sale_orders_tab" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sale.orders</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="sale_orders" string="Sale Orders">
                    <field name="sale_order_ids" domain="[('partner_id', '=', id)]" create="false" edit="false"
                           readonly="1">
                        <tree readonly="1">
                            <field name="name" string="Order Reference"/>
                            <field name="date_order" string="Order Date"/>
                            <field name="user_id" string="Salesperson"/>
                            <field name="amount_total" string="Total" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="state" string="Status"/>
                            <button name="action_open_form_view" string="View" type="object" class="btn-primary"/>
                        </tree>
                    </field>
                </page>


                <page name="purchase_orders" string="Purchase Orders">
                    <field name="purchase_order_ids" domain="[('partner_id', '=', id)]">

                        <tree create="0">
                            <field name="name" string="Purchase Order"/>
                            <field name="date_order" string="Order Deadline"/>
                            <field name="origin" string="Source Document"/>
                            <field name="user_id" string="Buyer"/>
                            <field name="amount_untaxed" string="Untaxed Amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_total" string="Total" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="state" string="Status"/>
                            <field name="invoice_status" string="Billing Status"/>
                            <button name="action_open_form_view" string="View" type="object" class="btn-primary"/>
                        </tree>
                    </field>
                </page>

                <page name="customer_invoices" string="Customer Invoices">
                    <field name="invoice_ids" domain="[('move_type', '=', 'out_invoice')]">
                        <tree create="0">
                            <field name="name" string="Invoice Number"/>
                            <field name="invoice_date" string="Invoice Date"/>
                            <field name="invoice_date_due" string="Due Date"/>
                            <field name="invoice_origin" string="Source Document"/>
                            <field name="user_id" string="Salesperson"/>
                            <field name="amount_untaxed" string="Untaxed Amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_tax_signed" string="Tax" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="amount_total_signed" string="Total" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="amount_residual_signed" string="Amount Due" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="payment_state" string="Payment Status"/>
                            <field name="state" string="Status"/>
                            <button name="action_open_form_view" string="View" type="object" class="btn-primary"/>
                        </tree>
                    </field>
                </page>

                <page name="vendor_bills" string="Vendor Bills">
                    <field name="vendor_bill_ids" domain="[('move_type', '=', 'in_invoice')]">
                        <tree create="0">
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="payment_reference"/>
                            <field name="invoice_date_due"/>
                            <field name="invoice_origin"/>
                            <field name="user_id"/>
                            <field name="amount_untaxed_signed" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="amount_tax_signed" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="amount_total_signed" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="amount_residual_signed" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="state"/>
                            <button name="action_open_form_view" string="View" type="object" class="btn-primary"/>
                        </tree>
                    </field>
                </page>

                <page name="incoming_orders" string="Incoming Orders">
                    <field name="incoming_picking_ids" domain="[('partner_id', '=', id)]">
                        <tree create="0">
                            <field name="name" string="Reference"/>
                            <field name="location_dest_id" string="Destination Location"/>
                            <field name="scheduled_date" string="Scheduled Date"/>
                            <field name="origin" string="Source Document"/>
                            <field name="backorder_id" string="Back Order of"/>
                            <field name="state" string="Status"/>
                            <button name="action_open_form_view" string="View" type="object" class="btn-primary"/>
                        </tree>
                    </field>
                </page>

                <page name="delivery_orders" string="Delivery Orders">
                    <field name="delivery_picking_ids" mode="tree" domain="[('partner_id', '=', id)]">
                        <tree create="0">
                            <field name="name" string="Delivery Order"/>
                            <field name="location_dest_id" string="Destination Location"/>
                            <field name="scheduled_date" string="Scheduled Date"/>
                            <field name="origin" string="Source Document"/>
                            <field name="backorder_id" string="Back Order of"/>
                            <field name="state" string="Status"/>
                            <button name="action_open_form_view" string="View" type="object" class="btn-primary"/>
                        </tree>
                    </field>
                </page>

                <page name="tasks" string="Tasks">
                    <field name="task_ids">
                        <tree create="0">
                            <field name="name" string="Title"/>
                            <field name="project_id" string="Project"/>
                            <field name="user_ids" string="Assignees"/>
                            <field name="stage_id" string="Stage"/>
                            <button name="action_open_form_view" string="View" type="object" class="btn-primary"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>